# Grafana credentials / locking
# The admin login stays as the BREAK-GLASS account: it is how you get in when
# Cloudflare is unavailable, over an SSH tunnel (see docs/access.md). Give it a
# real password — day-to-day access does not use it, so nobody needs to know it.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-to-something-long
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false

# ── Cloudflare Access → Grafana single sign-on ───────────────────────────────
# Cloudflare Access authenticates the user (corporate SSO + MFA) and forwards
# their email in a header. Grafana trusts that header and provisions the account
# on first login, so developers are managed ENTIRELY in the Access policy — no
# Grafana user administration, no shared password.
#
# ⚠️ SECURITY: auth.proxy means "whoever sends this header IS that user". It is
# only safe because Grafana publishes no port (see docker-compose.yml) and the
# whitelist below admits nothing but the cloudflared container. Do not publish
# Grafana's port while this is enabled, and do not widen the whitelist.
GF_AUTH_PROXY_ENABLED=true
GF_AUTH_PROXY_HEADER_NAME=Cf-Access-Authenticated-User-Email
GF_AUTH_PROXY_HEADER_PROPERTY=email
GF_AUTH_PROXY_AUTO_SIGN_UP=true
# Only the cloudflared container may assert an identity (fixed IP in the compose
# network). Any other source is ignored.
GF_AUTH_PROXY_WHITELIST=172.28.0.10
# Re-read the header on every request, so revoking someone in Cloudflare takes
# effect immediately instead of lasting until a cached session expires.
GF_AUTH_PROXY_SYNC_TTL=0
GF_AUTH_PROXY_ENABLE_LOGIN_TOKEN=false
# Everyone lands as Viewer. Promote the few who need more, once, in Grafana.
GF_USERS_AUTO_ASSIGN_ORG=true
GF_USERS_AUTO_ASSIGN_ORG_ROLE=Viewer

# Cloudflare Tunnel credential for the cloudflared container. Created in the
# Cloudflare dashboard (Zero Trust → Networks → Tunnels); see docs/access.md.
# It is a credential — it belongs in the MONITOR_ENV_STAGING secret, never here.
TUNNEL_TOKEN=

# DigitalOcean Spaces credentials used by Loki (and optionally Tempo if updated)
SPACES_KEY=your-spaces-key
SPACES_SECRET=your-spaces-secret
SPACES_BUCKET=pyron-monitor-stack
SPACES_PREFIX=loki
SPACES_REGION=fra1
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com

# AlertManager can optionally post to a webhook; provide the URL used by your team
ALERT_WEBHOOK_URL=https://hooks.example.com/services/abcd/1234/efgh
