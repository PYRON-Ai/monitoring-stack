# Grafana credentials / locking
# The admin login stays as the BREAK-GLASS account: it is how you get in when
# Cloudflare is unavailable, over an SSH tunnel (see docs/access.md). Give it a
# real password — day-to-day access does not use it, so nobody needs to know it.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me-to-something-long
GF_USERS_ALLOW_SIGN_UP=false
GF_AUTH_ANONYMOUS_ENABLED=false

# ── Cloudflare Access → Grafana single sign-on (CURRENTLY OFF) ──────────────
# Cloudflare Access already authenticates every request before it reaches the
# tunnel, so nobody unauthenticated gets this far. What is off is the second
# step: having Grafana ADOPT that identity instead of asking for its own login.
#
# It is off because auth.proxy works by trusting an identity header from a
# whitelisted address, and the tunnel now runs as a systemd unit on the host
# rather than as a container. Traffic therefore arrives from the bridge gateway
# (172.28.0.1), which every container on the network can also reach — so a
# whitelist naming it would let any container assert any identity. That is a
# meaningfully weaker guarantee than the one this was built for.
#
# Consequence today: Access controls WHO gets in, but everyone then signs in to
# Grafana with the shared admin account, so Grafana itself cannot tell people
# apart. Acceptable for staging; worth fixing before this carries anything that
# needs per-person attribution.
#
# The clean fix is auth.jwt: Access also sends Cf-Access-Jwt-Assertion, a signed
# token Grafana can VERIFY against Cloudflare's public keys — which depends on a
# signature rather than on where the packet came from, and so is unaffected by
# the tunnel living on the host. See docs/access.md.
#
# GF_AUTH_PROXY_ENABLED=true
# GF_AUTH_PROXY_HEADER_NAME=Cf-Access-Authenticated-User-Email
# GF_AUTH_PROXY_HEADER_PROPERTY=email
# GF_AUTH_PROXY_AUTO_SIGN_UP=true
# GF_AUTH_PROXY_WHITELIST=<the tunnel's source address>
# GF_AUTH_PROXY_SYNC_TTL=0
# GF_AUTH_PROXY_ENABLE_LOGIN_TOKEN=false
# GF_USERS_AUTO_ASSIGN_ORG=true
# GF_USERS_AUTO_ASSIGN_ORG_ROLE=Viewer

# NOTE: there is no TUNNEL_TOKEN here any more. cloudflared runs as a systemd
# unit on the droplet and reads its token from /etc/cloudflared/token (mode 0600,
# root-only), so the credential never passes through this file, the deploy
# pipeline, or the MONITOR_ENV_STAGING secret.

# DigitalOcean Spaces credentials used by Loki (and optionally Tempo if updated)
SPACES_KEY=your-spaces-key
SPACES_SECRET=your-spaces-secret
SPACES_BUCKET=pyron-monitor-stack
SPACES_PREFIX=loki
SPACES_REGION=fra1
SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com

# AlertManager can optionally post to a webhook; provide the URL used by your team
ALERT_WEBHOOK_URL=https://hooks.example.com/services/abcd/1234/efgh
